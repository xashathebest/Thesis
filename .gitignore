# Python
__pycache__/
*.py[cod]
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Training artifacts
*.pt
*.pth
*.onnx
*.tflite
*.engine
*.mlmodel

# Generated image derivatives. Immutable raw images are versioned with Git LFS
# using the repository's .gitattributes rules.
dataset/cleaned/**/*
dataset/standardized/**/*
dataset/masks/**/*
dataset/crops/**/*
dataset/splits/**/*
# Git cannot re-include a file while one of its parent directories remains
# ignored, so retain the documented directory skeleton explicitly.
!dataset/**/
!dataset/**/README.md
!dataset/**/.gitkeep

# Local audit/runtime scratch data
tmp/
.audit_tmp/
